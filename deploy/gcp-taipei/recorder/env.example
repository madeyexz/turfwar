# /etc/turfwar-rec/env (root, mode 0600): written by install.sh's caller over ssh, never committed.
STDB_URI=ws://127.0.0.1:8080
STDB_DB=turfwar
REC_ENV=tw
REC_DIR=/var/lib/turfwar-rec
REC_BUCKET=turfwar-rec
REC_SPOOL_MAX_MB=2048
R2_ACCOUNT_ID=<cloudflare account id>
R2_REC_VM_ACCESS_KEY_ID=<turfwar-rec-vm token id>
R2_REC_VM_SECRET_ACCESS_KEY=<sha256 of the turfwar-rec-vm token value>
TURFWAR_ADMIN_KEY=<the admin key>
REC_SALT=<REC_SALT>
