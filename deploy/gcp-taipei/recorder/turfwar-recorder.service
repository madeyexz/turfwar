# The match recorder (docs/RECORDING.md): an SDK client of the local SpacetimeDB that writes one segment
# per round to R2. Low priority and capped, so the game server always comes first.
[Unit]
Description=Turf War match recorder
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=turfwar-rec
EnvironmentFile=/etc/turfwar-rec/env
ExecStart=/opt/turfwar-rec/bin/bun /opt/turfwar-rec/recorder.js
Restart=always
RestartSec=5
Nice=10
CPUWeight=20
# One garbage-collector marker thread: with the default (one per core) the idle markers spin (on the orb
# 16-20% of a core went to 0-1%). Frames cost the Taipei VM ~4% of a vCPU per room even with the own
# reader, so the recorder takes them only from rooms with a subject (docs/RECORDING.md).
Environment=BUN_JSC_numberOfGCMarkers=1
MemoryMax=350M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/turfwar-rec
PrivateTmp=true

[Install]
WantedBy=multi-user.target
