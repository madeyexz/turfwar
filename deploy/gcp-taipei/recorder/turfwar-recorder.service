# The match recorder (docs/RECORDING.md): an SDK client of the local SpacetimeDB that writes one segment
# per round to R2. Low priority and capped, so the game server always comes first.
[Unit]
Description=Turf War match recorder
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=turfwar-rec
EnvironmentFile=/etc/turfwar-rec/env
ExecStart=/opt/turfwar-rec/bin/bun /opt/turfwar-rec/recorder.js
Restart=always
RestartSec=5
Nice=10
CPUWeight=20
# One garbage-collector marker thread: with the default (one per core) the idle markers spin, and the
# recorder used ~12% of a vCPU per open room on the 2-vCPU VM; with one it uses ~1% (docs/RECORDING.md).
Environment=BUN_JSC_numberOfGCMarkers=1
MemoryMax=350M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/turfwar-rec
PrivateTmp=true

[Install]
WantedBy=multi-user.target
