# Server only; never prefix this with VITE_. Presets work without a key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Online multiplayer (public values, no credentials). Use "same-origin" with the dev server's
# /stdb proxy to a local SpacetimeDB, or a wss:// URI such as wss://maincloud.spacetimedb.com.
VITE_SPACETIMEDB_URI=same-origin
VITE_SPACETIMEDB_DATABASE=turfwar
# Product analytics (PostHog, US cloud). Public values: the project token is a phc_… key that
# browsers send with events. Leave the key empty for local development (analytics is then a silent
# no-op); the dev server only sends with ?analytics in the URL, as test events.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
