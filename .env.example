# Server only; never prefix this with VITE_. Presets work without a key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Online multiplayer (public values, no credentials). Use "same-origin" with the dev server's
# /stdb proxy to a local SpacetimeDB, or a wss:// URI such as wss://maincloud.spacetimedb.com.
VITE_SPACETIMEDB_URI=same-origin
VITE_SPACETIMEDB_DATABASE=lawbreaker
