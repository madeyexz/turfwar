{
  "name": "lawbreaker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.10",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "preview": "vite preview --host 0.0.0.0",
    "dev:spacetime": "./scripts/dev-spacetime.sh",
    "typecheck:module": "bun run --cwd spacetimedb typecheck",
    "publish:prod": "bash deploy/instacloud/publish.sh"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "posthog-js": "^1.438.1",
    "spacetimedb": "2.10.2",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/three": "^0.180.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
